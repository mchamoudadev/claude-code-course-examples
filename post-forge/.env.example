# ==============================================================================
# PostForge — environment contract (.env.example)
#
# Copy this file to `.env` and fill in real values:   cp .env.example .env
# All secrets are read through `src/lib/env.ts` (never `process.env` directly).
#
# ALL AI (text + poster image) routes through OpenRouter — a full end-to-end run
# needs only: an OpenRouter key + a Serper key + a MongoDB URI. The model + tuning
# defaults below are working values; you can run with just the two keys filled in.
# ==============================================================================

# --- OpenRouter (every model call: all agents + poster image) -----------------
# Canonical name is OPENROUTER_API_KEY.
# ALIAS: the code also accepts the legacy name OPEN_ROUTER (see
# requireOpenRouterKey() in src/lib/env.ts), so an existing `.env` that already
# uses OPEN_ROUTER keeps working. Prefer OPENROUTER_API_KEY going forward.
OPENROUTER_API_KEY=

# --- Model tiers (OpenRouter model ids; all optional — working defaults set) ---
# Resolution per tier: per-run options.model -> the tier var -> LLM_MODEL -> the
# built-in fallback in src/lib/models.ts.
#
# NOTE (report R-0031, supersedes R-0017): openai/gpt-5.x models work here now.
# The earlier "Provider returned error" was NOT a model issue — the fetch_url tool
# schema used Zod `.url()` → JSON-Schema `format:"uri"`, which OpenAI's STRICT
# function-calling rejects (Gemini ignored it, masking the cause). Fixed in
# src/agents/tools/fetch_url.ts. All text tiers now run on openai/gpt-5.4-mini.
# google/gemini-2.5-flash-lite remains a proven, cheaper alternative.
#
# SMART: orchestration / quality agents (Verify, Editor).
LLM_MODEL_SMART=openai/gpt-5.4-mini
# CHEAP: post writing + light agents (Research, Writer, Illustrator, Publisher).
LLM_MODEL_CHEAP=openai/gpt-5.4-mini
# General fallback when a tier isn't specified.
LLM_MODEL=openai/gpt-5.4-mini
# Poster image model (OpenRouter, image-capable). Default = "Nano Banana".
IMAGE_MODEL=google/gemini-3.1-flash-image

# --- Web search (Research + Verify agents) ------------------------------------
# Serper.dev API key -> POST https://google.serper.dev/search (X-API-KEY header).
SERPER_API_KEY=

# --- Persistence --------------------------------------------------------------
# MongoDB connection string (posts + GridFS posters + users + sessions).
#
# TWO ENVIRONMENTS, ONE VARIABLE (idiomatic Next.js — resolved by NODE_ENV):
#   • LOCAL dev  -> this file (.env): a local mongod.
#       MONGODB_URI=mongodb://127.0.0.1:27017/postforge
#   • PRODUCTION -> set MONGODB_URI in the deploy env / secret store to the Atlas
#       SRV string (see .env.production.example). Example shape:
#       MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/postforge?retryWrites=true&w=majority
#   Atlas SRV enables TLS by default. Restrict the Atlas IP allowlist to the
#   server's egress IP and use a least-privilege DB user (readWrite on `postforge`).
MONGODB_URI=mongodb://127.0.0.1:27017/postforge

# --- Auth (username/password sessions) ----------------------------------------
# Sessions are DB-backed (the `sessions` collection) with an httpOnly cookie —
# no extra secret required. Cookies are marked Secure automatically when
# NODE_ENV=production, so production MUST be served over HTTPS.

# --- Inngest (durable orchestration) ------------------------------------------
# Dev mode: the SDK defaults to CLOUD mode and 500s the /api/inngest route when
# no signing key is present (report R-0002). `npm run dev` already exports
# INNGEST_DEV=1 so the route serves and `inngest-cli dev` can sync locally. Set to
# 1 for local dev; leave UNSET in production so the SDK uses cloud mode (with the
# signing key below).
# INNGEST_DEV=1
#
# Event/signing keys are only required for non-local / production Inngest. Leave
# BLANK for local dev (`npx inngest-cli@latest dev`), which needs no signed keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Superseded / optional (unused now that everything is OpenRouter) ----------
# Direct-provider keys are NOT needed. Kept only if you ever bypass OpenRouter.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# IMAGE_PROVIDER=gemini

# --- Rate-limit + dedupe on /api/generate (T19; optional, code defaults shown) ---
# MAX_INFLIGHT_RUNS: max concurrent non-terminal runs before POST /api/generate
# returns HTTP 429 (default 3).
MAX_INFLIGHT_RUNS=3
# DEDUPE_WINDOW_HOURS: look-back window for topic dedupe -> HTTP 409 (default 24).
DEDUPE_WINDOW_HOURS=24
