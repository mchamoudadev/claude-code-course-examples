# ==============================================================================
# PostForge — PRODUCTION environment template (.env.production.example)
#
# Do NOT commit real secrets. Copy the shape into your deploy platform's env /
# secret store (or a gitignored `.env.production`). `.env` (local dev) points at
# a local mongod; this file points production at MongoDB Atlas.
#
# See SECURITY_CHECKLIST.md before exposing this publicly.
# ==============================================================================

# Production mode: enables Secure cookies, Inngest cloud mode, the fail-closed
# checks, and the production CSP. Most hosts set this for you.
NODE_ENV=production

# --- Persistence: MongoDB Atlas (TLS on by default via SRV) --------------------
# Use a LEAST-PRIVILEGE user (readWrite on the `postforge` db only) and restrict
# the Atlas IP allowlist to this server's egress IP (never 0.0.0.0/0).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/postforge?retryWrites=true&w=majority

# --- AI + search (same as dev) -------------------------------------------------
# Use FRESH, rotated keys here — do not reuse dev keys, and never bake them into
# the image (see .dockerignore).
OPENROUTER_API_KEY=
SERPER_API_KEY=

# --- Model tiers ---------------------------------------------------------------
LLM_MODEL_SMART=openai/gpt-5.4-mini
LLM_MODEL_CHEAP=openai/gpt-5.4-mini
LLM_MODEL=openai/gpt-5.4-mini
IMAGE_MODEL=google/gemini-3.1-flash-image

# --- Inngest: REQUIRED in production -------------------------------------------
# INNGEST_DEV must be UNSET (the client throws at boot if it is truthy in prod).
# INNGEST_SIGNING_KEY is REQUIRED (the client throws at boot if missing) so the
# /api/inngest webhook verifies request signatures instead of running open.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Abuse limits (tune for real traffic) --------------------------------------
MAX_INFLIGHT_RUNS=3
DEDUPE_WINDOW_HOURS=24
